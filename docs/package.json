{
  "name": "tiktoklive-docs",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.2",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "python3 scripts/check_content.py",
    "generate": "python3 scripts/gen_api.py",
    "build": "python3 scripts/check_content.py && python3 scripts/gen_api.py && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "deploy:cloudflare": "wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@astrojs/starlight": "0.42.6",
    "astro": "7.4.1",
    "lucode-starlight": "1.0.0",
    "starlight-links-validator": "0.27.0",
    "unist-util-visit": "5.0.0",
    "wrangler": "4.151.2"
  }
}
